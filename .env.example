# =============================================================
# VARIABLES DE ENTORNO (plantilla, sin valores reales)
# Copia este archivo como ".env" y rellena los valores.
# ".env" está en .gitignore: nunca se sube al repositorio.
# Solo las variables que empiezan por VITE_ llegan al navegador,
# así que esas NUNCA deben ser secretas.
# =============================================================

# --- Supabase (público: la seguridad la da RLS) ---
# Project Settings > API: la Project URL y la clave sb_publishable_...
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Motor de IA del chat (Pollinations, gratis y sin clave) ---
VITE_IA_URL=https://text.pollinations.ai/openai
VITE_IA_MODELO=openai

# --- n8n (webhook del flujo del chat) ---
VITE_N8N_WEBHOOK_URL=

# =============================================================
# SOLO SERVIDOR (n8n). No llevan VITE_ y NO van en Netlify.
# Se configuran dentro de n8n; aquí quedan como recordatorio.
# =============================================================
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DREAMINA_API_KEY=

# --- Publicación / SEO ---
SITIO_URL=https://
