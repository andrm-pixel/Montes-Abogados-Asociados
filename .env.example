# =============================================================
# VARIABLES DE ENTORNO DEL AGENTE DE IA  (plantilla)
# Copia este archivo a ".env" y rellena los valores reales.
# El archivo ".env" esta en .gitignore: NUNCA se sube al repo
# ni llega al navegador (solo los VITE_* se exponen al cliente,
# y esos no son secretos).
# =============================================================

# --- Motor de IA (Pollinations, gratis y sin clave) ---
VITE_IA_URL=https://text.pollinations.ai/openai
VITE_IA_MODELO=openai

# --- Gemini (opcional; clave de https://aistudio.google.com/apikey) ---
# Solo la usa n8n en el servidor, nunca el navegador.
GEMINI_API_KEY=

# --- Supabase (proyecto general) ---
# URL y clave anon del proyecto (Settings > API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave de servicio: SOLO servidor/n8n, jamas en el front.
SUPABASE_SERVICE_ROLE_KEY=

# --- N8N (el flujo del chat y los videos) ---
# URL donde corre n8n y webhook del flujo importado.
N8N_URL=http://localhost:5678
N8N_WEBHOOK_URL=

# --- Dreamina (videos con el avatar) ---
DREAMINA_API_KEY=
DREAMINA_AVATAR=/imagenes/agente-avatar.jpg

# --- Publicacion / SEO ---
# Dominio final del sitio publicado (para sitemap y canonical).
SITIO_URL=https://
